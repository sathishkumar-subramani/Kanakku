# MongoDB Atlas: Database → Connect → Drivers → copy the URI and put your password in it.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=kanakku
# Any random string, at least 32 characters (node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Comma separated. Leave empty to allow any origin (bearer tokens, no cookies).
CLIENT_ORIGINS=https://kanakku.vercel.app,https://*.vercel.app
# Render sets PORT automatically. Locally the default is 5080.
# PORT=5080
